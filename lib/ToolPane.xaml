<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      MinWidth="200">
  <!-- The shell of EVERY pane, and only the shell: the tiles are built as WPF
       objects in toolpane.py, because the tool list is discovered at runtime and
       the filter needs a reference to every tile anyway. There is not one word in
       here about which tools a pane holds, which is why every pane loads this
       same file instead of having one each.

       NOT A SINGLE COLOUR IN HERE, on purpose. slantisui owns the palette, so
       every brush is assigned in code from ui.* (see _paint()). A hex written
       here would be the one thing a change of ACCENT could not retone, and it
       would add one more copy of the palette instead of using the styles that
       ui.styles_xaml() already hands over. -->
  <Grid Margin="10,10,10,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Search. The hint is a TextBlock laid over the box (WPF has no
         placeholder) and it is not hit-testable, so a click still lands on the
         TextBox underneath. -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <TextBox x:Name="txtSearch" Height="28" Padding="8,0"
               VerticalContentAlignment="Center"/>
      <TextBlock x:Name="lblHint" Text="Search tools" FontSize="12"
                 Margin="11,0,0,0" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="host"/>
    </ScrollViewer>

    <TextBlock Grid.Row="2" x:Name="lblCount" Margin="0,8,0,0" FontSize="11"/>
  </Grid>
</Page>
