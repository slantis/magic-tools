# Normalize line endings to LF in the repository; checkouts follow the OS.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.gif binary
*.ico binary
*.ttf binary
*.zip binary

# Repo tooling stays out of the release ZIP
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
